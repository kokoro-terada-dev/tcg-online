{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcg:effect-v3-subset:1",
  "title": "V3 compiler subset 1; compilation is not execution approval",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "cardId", "cardVersion", "name", "cardType", "baseStats", "colors", "traits", "attributes", "reviewStatus", "source", "effects"],
  "properties": {
    "schemaVersion": { "const": "3.0.0-subset.1" }, "cardId": { "$ref": "#/$defs/id" }, "cardVersion": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/label" }, "cardType": { "enum": ["leader", "character", "stage"] },
    "baseStats": {
      "type": "object", "additionalProperties": false, "required": ["cost", "power", "counter", "life"],
      "properties": { "cost": { "$ref": "#/$defs/stat" }, "power": { "$ref": "#/$defs/stat" }, "counter": { "$ref": "#/$defs/stat" }, "life": { "$ref": "#/$defs/stat" } }
    },
    "colors": { "$ref": "#/$defs/stringList" }, "traits": { "$ref": "#/$defs/stringList" }, "attributes": { "$ref": "#/$defs/stringList" },
    "reviewStatus": { "enum": ["needs_review", "unsupported", "approved"] },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["text", "triggerText", "displayIds", "datasetSha256"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 32768 }, "triggerText": { "type": "string", "maxLength": 32768 },
        "displayIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "datasetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "effects": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/effect" } }
  },
  "allOf": [
    { "if": { "properties": { "cardType": { "const": "leader" } } }, "then": { "properties": { "effects": { "items": { "properties": { "sourceZones": { "items": { "const": "leader" } } } } } } } },
    { "if": { "properties": { "cardType": { "const": "character" } } }, "then": { "properties": { "effects": { "items": { "properties": { "sourceZones": { "items": { "const": "character" } } } } } } } },
    { "if": { "properties": { "cardType": { "const": "stage" } } }, "then": { "properties": { "effects": { "items": { "properties": { "sourceZones": { "items": { "const": "stage" } } } } } } } }
  ],
  "$defs": {
    "id": { "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "not": { "enum": ["constructor", "prototype"] } },
    "label": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "stringList": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
    "stat": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "count": { "type": "integer", "minimum": 1, "maximum": 50 },
    "meta": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" },
        "sourceSpan": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 } } }
      }
    },
    "value": {
      "oneOf": [
        { "type": ["null", "boolean"] }, { "type": "string", "maxLength": 1000 }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "object", "additionalProperties": false, "required": ["ref"], "properties": { "ref": { "enum": ["SELF.lifeCount", "SELF.handCount", "OPPONENT.lifeCount", "OPPONENT.handCount"] } } }
      ]
    },
    "predicates": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/predicate" } },
    "predicate": {
      "allOf": [{ "$ref": "#/$defs/meta" }], "unevaluatedProperties": false,
      "oneOf": [
        { "required": ["conditions"], "properties": { "type": { "enum": ["all", "any"] }, "conditions": { "$ref": "#/$defs/predicates" } } },
        { "required": ["condition"], "properties": { "type": { "const": "not" }, "condition": { "$ref": "#/$defs/predicate" } } },
        { "required": ["left", "op", "right"], "properties": { "type": { "const": "compare" }, "left": { "$ref": "#/$defs/value" }, "op": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] }, "right": { "$ref": "#/$defs/value" } } }
      ]
    },
    "actions": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/action" } },
    "action": {
      "allOf": [{ "$ref": "#/$defs/meta" }], "unevaluatedProperties": false,
      "oneOf": [
        { "required": ["player", "count"], "properties": { "type": { "const": "DRAW" }, "player": { "enum": ["SELF", "OPPONENT"] }, "count": { "$ref": "#/$defs/count" } } },
        { "required": ["actions"], "properties": { "type": { "const": "SEQUENCE" }, "actions": { "$ref": "#/$defs/actions" } } },
        { "required": ["condition", "then", "else"], "properties": { "type": { "const": "IF" }, "condition": { "$ref": "#/$defs/predicate" }, "then": { "$ref": "#/$defs/actions" }, "else": { "$ref": "#/$defs/actions" } } }
      ]
    },
    "cost": { "allOf": [{ "$ref": "#/$defs/meta" }], "unevaluatedProperties": false, "required": ["count"], "properties": { "type": { "const": "REST_DON" }, "count": { "$ref": "#/$defs/count" } } },
    "timing": { "allOf": [{ "$ref": "#/$defs/meta" }], "unevaluatedProperties": false, "properties": { "type": { "const": "MAIN" } } },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "timing", "sourceZones", "optional", "activationConditions", "resolutionConditions", "costs", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "activated" }, "timing": { "$ref": "#/$defs/timing" }, "optional": { "const": false },
        "sourceZones": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["leader", "character", "stage"] } },
        "activationConditions": { "$ref": "#/$defs/predicate" }, "resolutionConditions": { "$ref": "#/$defs/predicate" },
        "costs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/cost" } }, "actions": { "allOf": [{ "$ref": "#/$defs/actions" }], "minItems": 1 }
      }
    }
  }
}
